{
  "name": "triggerdm-backend-staging",
  "main": "./worker.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "TRIGGERDM_RUNTIME": "production",
    "MONGODB_PRODUCTION_DB": "automationDB",
    "UPSTREAM_ORIGIN": ""
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "keep_vars": true
}
